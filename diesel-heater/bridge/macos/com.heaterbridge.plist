<?xml version="1.0" encoding="UTF-8"?>
<!-- Start heaterbridge at login. Edit the two paths, then:
     cp com.heaterbridge.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/com.heaterbridge.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.heaterbridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/heaterbridge/.venv/bin/heaterbridge</string>
    <string>-c</string>
    <string>/Users/YOU/heaterbridge/config.toml</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/heaterbridge.log</string>
  <key>StandardErrorPath</key><string>/tmp/heaterbridge.log</string>
</dict>
</plist>
